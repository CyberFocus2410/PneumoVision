# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.env
.venv
env/
venv/
ENV/

# Jupyter Notebook checkpoints
.ipynb_checkpoints

# Node / Vite
node_modules/
frontend/node_modules/
frontend/dist/
dist/
.vite/

# Large training data (exclude full NIH gigabytes, keep sample demo data)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/raw_cohort/*
!data/raw_cohort/.gitkeep

# Checkpoint binaries (can be regenerated or hosted on releases)
*.pt
*.pth
!models/checkpoints/model_metadata.json
!models/checkpoints/.gitkeep

# IDEs and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# Runtime generated static files
backend/static/heatmaps/*.png
!backend/static/heatmaps/.gitkeep
backend/static/reports/*.pdf
!backend/static/reports/.gitkeep
